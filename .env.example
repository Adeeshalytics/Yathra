# Docker Compose configuration. Copy to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=yathra
POSTGRES_USER=yathra
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis --------------------------------------------------------------------
REDIS_PORT=6379

# --- Django -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Payments -----------------------------------------------------------------
# "mock" is the built-in test gateway (no real money). Use "payhere" for real payments
# and set the credentials below; production refuses to start with "mock" enabled.
PAYMENT_PROVIDERS=mock
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true
# PAYHERE_APP_ID=
# PAYHERE_APP_SECRET=

# --- Text messages and e-mail (docs/notifications.md) ---------------------------
# "console" writes texts (and sign-in codes) to the backend log. Use "notifylk" for real texts.
SMS_BACKEND=console
# SMS_SENDER_ID=
# NOTIFYLK_USER_ID=
# NOTIFYLK_API_KEY=
# e.g. smtp+tls://user:password@smtp.example.com:587 (consolemail:// prints e-mails)
EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=Yathra <tickets@yathra.lk>

# --- Road routing (the line on the route map) ---------------------------------
# Development only: self-host OSRM for production (see docs/route-maps.md).
ROUTING_SERVICE_URL=https://router.project-osrm.org

# --- Next.js ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Yathra
# Map tiles. OpenStreetMap by default; see docs/route-maps.md before going to production.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
