# Used only when running Django directly on your machine (not via Docker Compose).
# Copy to backend/.env. Real environment variables always take precedence over this file.
# Settings module is chosen by DJANGO_SETTINGS_MODULE (default: config.settings.development).

# --- Core ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_ADMIN_URL=django-admin/
APP_NAME=Yathra

# --- Data stores (the Docker Compose db/redis services publish these ports) ---
DATABASE_URL=postgres://yathra:change-me@localhost:5432/yathra
DB_CONN_MAX_AGE=60
# Leave empty to fall back to an in-process memory cache.
REDIS_URL=redis://localhost:6379/0

# --- Browser access -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT ----------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# JWT_SIGNING_KEY=            # defaults to DJANGO_SECRET_KEY
# JWT_REFRESH_COOKIE_NAME=yathra_refresh
# JWT_REFRESH_COOKIE_DOMAIN=  # e.g. .yathra.lk in production (shared by app. and api.)
JWT_REFRESH_COOKIE_SECURE=false
# JWT_REFRESH_COOKIE_SAMESITE=Lax

# --- Payments -------------------------------------------------------------------
# Gateways customers can pay with, in the order they're offered. "mock" is the built-in
# test gateway: it takes no real money, and production refuses to start with it enabled.
PAYMENT_PROVIDERS=mock
# PAYMENT_DEFAULT_PROVIDER=mock
# Where gateways send customers back to, and where they post their notifications.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# How long seats stay held once payment starts, and the cap per booking.
# PAYMENT_WINDOW_MINUTES=10
# PAYMENT_MAX_HOLD_MINUTES=20
# When to give up on an attempt the gateway never reported on.
# PAYMENT_TIMEOUT_MINUTES=30
# PAYMENT_VERIFY_THROTTLE_RATE=20/min
# Signs the test gateway's notifications (derived from DJANGO_SECRET_KEY when empty).
# MOCK_PAYMENT_SECRET=

# --- PayHere (payhere.lk) ---------------------------------------------------------
# Real credentials belong in the environment, never in the repository.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true
# Optional Business App keys: enable status look-ups and refunds through PayHere's API.
# PAYHERE_APP_ID=
# PAYHERE_APP_SECRET=

# --- Rate limiting --------------------------------------------------------------
# THROTTLE_RATE_ANON=120/min
# THROTTLE_RATE_USER=600/min
# THROTTLE_RATE_AUTH=10/min

# --- Logging / docs -------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
# console (human readable) or json (for log shipping in production)
DJANGO_LOG_FORMAT=console
API_DOCS_ENABLED=true
